# ==========================================
# GLOBAL INFRASTRUCTURE CONFIGURATION
# ==========================================

# Shared Docker Network Name
NETWORK_NAME=sw_infra_net

# Local Routing Domains
TRAEFIK_DOMAIN=traefik.localhost
GITEA_DOMAIN=gitea.localhost
JENKINS_DOMAIN=jenkins.localhost
NEXUS_DOMAIN=nexus.localhost
SONAR_DOMAIN=sonar.localhost
PGADMIN_DOMAIN=pgadmin.localhost

# Default Timezone (Used by all containers)
TZ=UTC

# ==========================================
# POSTGRES SHARED DATABASE CONFIGURATION
# ==========================================

POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=CHANGE_ME_POSTGRES_ADMIN

GITEA_DB_HOST=postgres
GITEA_DB_PORT=5432
GITEA_DB_NAME=giteadb
GITEA_DB_USER=gitea_user
GITEA_DB_PASSWORD=CHANGE_ME_GITEA_DB

SONAR_DB_HOST=postgres
SONAR_DB_PORT=5432
SONAR_DB_NAME=sonardb
SONAR_DB_USER=sonar_user
SONAR_DB_PASSWORD=CHANGE_ME_SONAR_DB

# ==========================================
# GITEA CONFIGURATION
# (GITEA_DOMAIN is defined in Phase 1)
# ==========================================

GITEA_SSH_HOST_PORT=2222

GITEA_ADMIN_USER=admin
GITEA_ADMIN_PASSWORD=CHANGE_ME_GITEA_ADMIN
GITEA_ADMIN_EMAIL=admin@gitea.localhost

# ==========================================
# PGADMIN CONFIGURATION
# (PGADMIN_DOMAIN is defined in Phase 1)
# ==========================================

# Must be a valid address on a non-reserved domain (not *.localhost)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME_PGADMIN